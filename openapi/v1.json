{
  "openapi": "3.0.3",
  "info": {
    "title": "Session Zero API",
    "version": "v1"
  },
  "paths": {
    "/auth/me": {
      "get": {
        "summary": "Shows the current authenticated user",
        "operationId": "getCurrentUser",
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "current authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponse"
                }
              }
            }
          },
          "401": {
            "description": "unauthenticated"
          }
        }
      },
      "patch": {
        "summary": "Updates the current authenticated user",
        "operationId": "updateCurrentUser",
        "tags": [
          "Auth"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "responses": {
          "200": {
            "description": "current authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponse"
                }
              }
            }
          },
          "401": {
            "description": "unauthenticated"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCurrentUserRequest"
              }
            }
          },
          "required": true
        }
      }
    },
    "/auth/oauth/{provider}": {
      "post": {
        "summary": "Starts OAuth for a provider",
        "operationId": "startOauth",
        "tags": [
          "Auth"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          },
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "discord"
              ]
            }
          },
          {
            "name": "redirect",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "redirect to provider authorization flow",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      }
    },
    "/auth/oauth/{provider}/callback": {
      "get": {
        "summary": "Handles OAuth callback for a provider",
        "operationId": "handleOauthCallback",
        "tags": [
          "Auth"
        ],
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "discord"
              ]
            }
          },
          {
            "name": "redirect",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "redirect to client application",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      }
    },
    "/auth/oauth/failure": {
      "get": {
        "summary": "Handles OAuth failure",
        "operationId": "handleOauthFailure",
        "tags": [
          "Auth"
        ],
        "parameters": [
          {
            "name": "redirect",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "origin",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "message",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "redirect to client application with error",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Logs in with email and password",
        "operationId": "login",
        "tags": [
          "Auth"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "responses": {
          "200": {
            "description": "authenticated session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "description": "invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "password login is disabled"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAuthSessionRequest"
              }
            }
          },
          "required": true
        }
      }
    },
    "/auth/session": {
      "get": {
        "summary": "Shows the current auth session",
        "operationId": "getAuthSession",
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "current authentication session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Creates an auth session",
        "operationId": "createAuthSession",
        "tags": [
          "Auth"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "responses": {
          "200": {
            "description": "authenticated session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "description": "invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "password login is disabled"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAuthSessionRequest"
              }
            }
          },
          "required": true
        }
      },
      "delete": {
        "summary": "Destroys the current auth session",
        "operationId": "destroyAuthSession",
        "tags": [
          "Auth"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "responses": {
          "200": {
            "description": "unauthenticated session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me/games": {
      "get": {
        "summary": "Lists games associated with the current user's profiles",
        "operationId": "getCurrentUserGames",
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "current user's profile-grouped games",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GamesIndexResponse"
                }
              }
            }
          },
          "401": {
            "description": "unauthenticated"
          }
        }
      }
    },
    "/profile/user/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "get": {
        "summary": "Shows a user profile",
        "operationId": "getUserProfile",
        "tags": [
          "Profile"
        ],
        "responses": {
          "200": {
            "description": "user profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfilePageResponse"
                }
              }
            }
          },
          "401": {
            "description": "unauthenticated"
          },
          "404": {
            "description": "missing user profile"
          }
        }
      }
    },
    "/profile/gm/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "get": {
        "summary": "Shows a GM profile",
        "operationId": "getGmProfile",
        "tags": [
          "Profile"
        ],
        "responses": {
          "200": {
            "description": "GM profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GmProfileResponse"
                }
              }
            }
          },
          "401": {
            "description": "unauthenticated"
          },
          "404": {
            "description": "missing GM profile"
          }
        }
      }
    },
    "/profile/player/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "get": {
        "summary": "Shows a player profile",
        "operationId": "getPlayerProfile",
        "tags": [
          "Profile"
        ],
        "responses": {
          "200": {
            "description": "player profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayerProfileResponse"
                }
              }
            }
          },
          "401": {
            "description": "unauthenticated"
          },
          "404": {
            "description": "missing player profile"
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "parameters": {
      "CsrfToken": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "AuthResponse": {
        "type": "object",
        "required": [
          "authenticated",
          "csrfToken",
          "userId"
        ],
        "properties": {
          "authenticated": {
            "type": "boolean"
          },
          "csrfToken": {
            "type": "string"
          },
          "userId": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "CreateAuthSessionRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "CurrentUserResponse": {
        "type": "object",
        "required": [
          "id",
          "name",
          "profilePicture",
          "email",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "email": {
            "type": "string",
            "format": "email",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "profilePicture": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UpdateCurrentUserRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "profilePicture": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ProfileSummary": {
        "type": "object",
        "required": [
          "id",
          "displayName",
          "profilePicture"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "displayName": {
            "type": "string",
            "nullable": true
          },
          "profilePicture": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "UserProfileResponse": {
        "type": "object",
        "required": [
          "id",
          "name",
          "profilePicture"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "profilePicture": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UserProfilePageResponse": {
        "type": "object",
        "required": [
          "userInfo",
          "gmProfiles",
          "playerProfiles"
        ],
        "properties": {
          "userInfo": {
            "$ref": "#/components/schemas/UserProfileResponse"
          },
          "gmProfiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GmProfileResponse"
            }
          },
          "playerProfiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlayerProfileResponse"
            }
          }
        }
      },
      "GmProfileResponse": {
        "type": "object",
        "required": [
          "id",
          "name",
          "profilePicture",
          "bio",
          "systems",
          "isUserPublic"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "userId": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "profilePicture": {
            "type": "string",
            "nullable": true
          },
          "bio": {
            "type": "string",
            "nullable": true
          },
          "systems": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "isUserPublic": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastUsedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PlayerProfileResponse": {
        "type": "object",
        "required": [
          "id",
          "characterName",
          "characterImage",
          "characterDescription",
          "isAccepted",
          "isUserPublic"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "userId": {
            "type": "integer"
          },
          "characterName": {
            "type": "string",
            "nullable": true
          },
          "characterImage": {
            "type": "string",
            "nullable": true
          },
          "characterDescription": {
            "type": "string",
            "nullable": true
          },
          "characterSheetLink": {
            "type": "string",
            "nullable": true
          },
          "isAccepted": {
            "type": "boolean"
          },
          "isUserPublic": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastUsedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GameSummary": {
        "type": "object",
        "required": [
          "id",
          "name",
          "system",
          "description",
          "playerCount"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "system": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "playerCount": {
            "type": "integer"
          }
        }
      },
      "GameSummaryAsGm": {
        "allOf": [
          {
            "$ref": "#/components/schemas/GameSummary"
          }
        ]
      },
      "GameSummaryAsPlayer": {
        "allOf": [
          {
            "$ref": "#/components/schemas/GameSummary"
          },
          {
            "type": "object",
            "required": [
              "playerProfile",
              "gmProfile"
            ],
            "properties": {
              "playerProfile": {
                "$ref": "#/components/schemas/ProfileSummary"
              },
              "gmProfile": {
                "$ref": "#/components/schemas/ProfileSummary"
              }
            }
          }
        ]
      },
      "GmIdentitySummary": {
        "type": "object",
        "required": [
          "id",
          "displayName",
          "profilePicture",
          "games"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "displayName": {
            "type": "string",
            "nullable": true
          },
          "profilePicture": {
            "type": "string",
            "nullable": true
          },
          "games": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GameSummaryAsGm"
            }
          }
        }
      },
      "GamesIndexResponse": {
        "type": "object",
        "x-type-aliases": {
          "GamesIndexGmIdentity": "gmIdentities[number]",
          "GamesIndexGameAsGm": "gmIdentities[number].games[number]",
          "GamesIndexGameAsPlayer": "gamesAsPlayer[number]"
        },
        "required": [
          "gmIdentities",
          "gamesAsPlayer"
        ],
        "properties": {
          "gmIdentities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GmIdentitySummary"
            }
          },
          "gamesAsPlayer": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GameSummaryAsPlayer"
            }
          }
        }
      }
    }
  }
}