{
  "openapi": "3.0.3",
  "info": {
    "title": "Session Zero API",
    "version": "v1"
  },
  "paths": {
    "/auth/me": {
      "get": {
        "summary": "Shows the current authenticated user",
        "operationId": "getCurrentUser",
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "current authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponse"
                }
              }
            }
          },
          "401": {
            "description": "unauthenticated"
          }
        }
      },
      "patch": {
        "summary": "Updates the current authenticated user",
        "operationId": "updateCurrentUser",
        "tags": [
          "Auth"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "responses": {
          "200": {
            "description": "current authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponse"
                }
              }
            }
          },
          "401": {
            "description": "unauthenticated"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCurrentUserRequest"
              }
            }
          },
          "required": true
        }
      }
    },
    "/auth/session": {
      "get": {
        "summary": "Shows the current auth session",
        "operationId": "getAuthSession",
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "current authentication session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Creates an auth session",
        "operationId": "createAuthSession",
        "tags": [
          "Auth"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "responses": {
          "200": {
            "description": "authenticated session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "description": "invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "password login is disabled"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAuthSessionRequest"
              }
            }
          },
          "required": true
        }
      },
      "delete": {
        "summary": "Destroys the current auth session",
        "operationId": "destroyAuthSession",
        "tags": [
          "Auth"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "responses": {
          "200": {
            "description": "unauthenticated session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "parameters": {
      "CsrfToken": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "AuthResponse": {
        "type": "object",
        "required": [
          "authenticated",
          "csrfToken",
          "userId"
        ],
        "properties": {
          "authenticated": {
            "type": "boolean"
          },
          "csrfToken": {
            "type": "string"
          },
          "userId": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "CreateAuthSessionRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "CurrentUserResponse": {
        "type": "object",
        "required": [
          "id",
          "name",
          "profilePicture",
          "email",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "email": {
            "type": "string",
            "format": "email",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "profilePicture": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UpdateCurrentUserRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "profilePicture": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}